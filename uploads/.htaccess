# Interdire tout accès HTTP direct
Require all denied

# Désactiver le moteur PHP dans ce répertoire (sécurité supplémentaire)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Désactiver le listing du répertoire
Options -Indexes
